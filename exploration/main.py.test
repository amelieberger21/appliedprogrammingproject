from pydantic import BaseModel
import json
import os

app = FastAPI()

FILE_NAME = "notes.json"

# --------- Hilfsfunktionen ---------
def load_notes():
    if not os.path.exists(FILE_NAME):
        return []
    with open(FILE_NAME, "r") as f:
        return json.load(f)

def save_notes(notes):
    with open(FILE_NAME, "w") as f:
        json.dump(notes, f, indent=4)

# --------- Modelle ---------
class NoteCreate(BaseModel):
    title: str
    content: str
    category: str

class Note(NoteCreate):
    id: int

@app.get("/notes")
def list_notes() -> list[Note]:
    """Get a list of all notes"""
    notes_db, _ = load_notes()
    return notes_db

# --------- Endpunkte ---------

# 3. Notizen nach Kategorie filtern
@app.get("/notes/category/{category_name}")
def get_notes_by_category(category_name: str):
    notes = load_notes()
    filtered = [note for note in notes if note["category"].lower() == category_name.lower()]
    return filtered

# 4. Statistik-Endpunkt
@app.get("/notes/statistics")
def get_statistics():
    notes = load_notes()
    stats = {"total": len(notes), "categories": {}}

    for note in notes:
        cat = note["category"]
        stats["categories"][cat] = stats["categories"].get(cat, 0) + 1

    return stats

# 1. Einzelne Notiz abrufen
@app.get("/notes/{id}")
def get_note(id: int):
    notes = load_notes()
    for note in notes:
        if note["id"] == id:
            return note
    raise HTTPException(status_code=404, detail="Note not found")

# 2. Notiz erstellen (mit Kategorie)
@app.post("/notes")
def create_note(note: NoteCreate):
    notes = load_notes()
    new_id = max([n["id"] for n in notes], default=0) + 1

    new_note = {
        "id": new_id,
        "title": note.title,
        "content": note.content,
        "category": note.category
    }

    notes.append(new_note)
    save_notes(notes)
    return new_note

# 5. Bonus: Notiz löschen
@app.delete("/notes/{id}")
def delete_note(id: int):
    notes = load_notes()
    updated_notes = [note for note in notes if note["id"] != id]

    if len(notes) == len(updated_notes):
        raise HTTPException(status_code=404, detail="Note not found")

    save_notes(updated_notes)
    return {"message": "Note deleted successfully"}

